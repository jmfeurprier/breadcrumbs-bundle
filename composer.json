{
    "name": "jmf/breadcrumbs-bundle",
    "description" : "Breadcrumbs bundle for Symfony",
    "license": "mit",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.3",
        "jmf/template-rendering": "^2.0",
        "symfony/framework-bundle": "^7.0|^8.0",
        "symfony/property-access": "^7.0|^8.0",
        "twig/twig": "^3.0",
        "webmozart/assert": "^1.0|^2.0"
    },
    "require-dev": {
        "overtrue/phplint": "^9.7",
        "phpstan/phpstan": "^2.1.11",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.3|^13.0",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "config": {
        "audit": {
            "abandoned": "report"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Jmf\\Breadcrumbs\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jmf\\Breadcrumbs\\Tests\\": "tests"
        }
    }
}
